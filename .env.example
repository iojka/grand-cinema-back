# Copier ce fichier en .env (non versionné) et adapter les valeurs.
SECRET_KEY=a-remplacer-par-une-longue-chaine-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://grandcinema:grandcinema@localhost:5433/grandcinema
# Adresses du front autorisées à appeler l'API (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Paiement Stripe en mode test (US 3.1) : tableau de bord Stripe et
# commande « stripe listen » pour la clé du webhook en local
STRIPE_SECRET_KEY=sk_test_a-remplacer
STRIPE_WEBHOOK_SECRET=whsec_a-remplacer
# Adresse du front (retour après la page de paiement)
FRONT_URL=http://localhost:5173
